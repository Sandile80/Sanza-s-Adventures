body {
  background: white;
  font-family: Arial, sans-serif;

}

h2 {
  text-align: left;
  margin-bottom: 20px;
  color: black

}

image.logo {
  display: block;
  margin: 0 auto 20px;
  max-width: 50%;
  height: auto;
}



.container {
  max-width: 600px;
  background: white;
  margin: 100px auto;
  padding: 100px;
  border-radius: 8px;
  box-shadow: 0 0 10px rgba(0,0,0,0.1);

}

 

h1 {
  text-align: left;

}

 

.step {

  display: none;

}

 

.step.active {

  display: block;

}

 

label {

  display: block;
  margin-top: 15px;

}

 

input, select {

  width: 100%;
  padding: 10px;
  margin-top: 5px;

}

 

.buttons {

  margin-top: 20px;
  display: flex;
  justify-content: space-between;

}

 

button {

  padding: 10px 20px;
  cursor: pointer;

}

 

.consent-box {

  background: #f1f1f1;
  padding: 15px;
  margin-bottom: 15px;
  font-size: 14px;

}

 canvas {

  border: 2px solid #000;

  width: 100%;

  height: 200px;

  margin-bottom: 10px;

  background: #fff;

}
